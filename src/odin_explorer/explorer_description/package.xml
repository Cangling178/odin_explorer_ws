<?xml version="1.0"?>
<package format="3">
  <name>explorer_description</name>
  <version>0.1.0</version>
  <description>Retained chassis, wheels, motors and ODIN housing Xacro/STL with RViz preview. Geometry and inertia include modeling assumptions, not hardware calibration. Simulated sensor frames were removed</description>
  <maintainer email="maintainer@example.invalid">Project Maintainer</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
