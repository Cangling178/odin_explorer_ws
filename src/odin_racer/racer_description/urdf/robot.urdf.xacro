<?xml version="1.0"?>
<!-- Illustrative dimensions only. Two rear driven wheels and two front casters.
     Visual preview only: no physics, actuator plugin or measured calibration. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="odin_racer_preview">
  <material name="body"><color rgba="0.12 0.35 0.55 1"/></material>
  <material name="rubber"><color rgba="0.12 0.12 0.12 1"/></material>
  <material name="sensor"><color rgba="0.9 0.55 0.15 1"/></material>
  <!-- Control origin at rear axle center, x forward, y left, z up. -->
  <link name="base_link">
    <visual>
      <origin xyz="0.10 0 0.055"/>
      <geometry><box size="0.34 0.22 0.07"/></geometry>
      <material name="body"/>
    </visual>
  </link>
  <xacro:macro name="drive_wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.045" length="0.025"/></geometry>
        <material name="rubber"/>
      </visual>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} 0"/><axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:drive_wheel side="left" y="0.125"/>
  <xacro:drive_wheel side="right" y="-0.125"/>
  <!-- Casters are symbolic spheres; measured swivel/rolling joints are pending. -->
  <xacro:macro name="caster" params="side y">
    <link name="front_${side}_caster_link">
      <visual><geometry><sphere radius="0.025"/></geometry><material name="rubber"/></visual>
    </link>
    <joint name="front_${side}_caster_mount" type="fixed">
      <parent link="base_link"/><child link="front_${side}_caster_link"/>
      <origin xyz="0.22 ${y} -0.02"/>
    </joint>
  </xacro:macro>
  <xacro:caster side="left" y="0.085"/>
  <xacro:caster side="right" y="-0.085"/>
  <link name="odin_link">
    <visual><geometry><box size="0.05 0.10 0.06"/></geometry><material name="sensor"/></visual>
  </link>
  <joint name="odin_mount" type="fixed">
    <parent link="base_link"/><child link="odin_link"/><origin xyz="0.20 0 0.13"/>
  </joint>
</robot>
