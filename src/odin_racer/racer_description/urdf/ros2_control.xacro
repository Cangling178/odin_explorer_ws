<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="simulation_wheel_interface" params="side">
    <joint name="${side}_wheel_joint">
      <param name="vel_kp">${actuation['velocity_kp']}</param>
      <param name="vel_ki">${actuation['velocity_ki']}</param>
      <param name="vel_kd">${actuation['velocity_kd']}</param>
      <param name="vel_max_integral_error">${actuation['velocity_integral_torque_limit_nm']}</param>
      <param name="vel_min_integral_error">${-actuation['velocity_integral_torque_limit_nm']}</param>
      <param name="vel_antiwindup">true</param>
      <command_interface name="velocity">
        <param name="min">${-actuation['wheel_velocity_limit_radps']}</param>
        <param name="max">${actuation['wheel_velocity_limit_radps']}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>
  <xacro:macro name="simulation_control">
    <ros2_control name="GazeboSystem" type="system">
      <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
      <xacro:simulation_wheel_interface side="left"/>
      <xacro:simulation_wheel_interface side="right"/>
    </ros2_control>
  </xacro:macro>
</robot>
