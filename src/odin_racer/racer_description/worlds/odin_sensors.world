<?xml version="1.0"?>
<sdf version="1.6">
  <world name="odin_sensor_bench">
    <gravity>0 0 -9.81</gravity>
    <physics type="ode"><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate></physics>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0 -1</direction></light>
    <model name="floor"><static>true</static><link name="floor">
      <collision name="floor"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
      <visual name="floor"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
    </link></model>
    <model name="target"><static>true</static><pose>2 0 0.5 0 0 0</pose><link name="target">
      <collision name="target"><geometry><box><size>0.1 1 1</size></box></geometry></collision>
      <visual name="target"><geometry><box><size>0.1 1 1</size></box></geometry><material><diffuse>0.8 0.15 0.08 1</diffuse></material></visual>
    </link></model>
    <!-- Stationary, elevated sensor bench, NOT the complete drive simulation.
         Same odin_link origin as URDF. Body geometry and 280 g are shared. -->
    <model name="odin_sensor_bench"><static>true</static><pose>0 0 0.5 0 0 0</pose>
      <link name="odin_link">
        <visual name="body"><geometry><mesh><uri>file://ODIN_MESH_PATH</uri></mesh></geometry></visual>
        <sensor name="lidar" type="ray">
          <pose>0.01555 0.0055 0.031 0 0 0</pose><always_on>true</always_on><update_rate>10</update_rate>
          <ray><scan>
            <horizontal><samples>240</samples><resolution>1</resolution><min_angle>-1.0471975512</min_angle><max_angle>1.0471975512</max_angle></horizontal>
            <vertical><samples>180</samples><resolution>1</resolution><min_angle>-0.7853981634</min_angle><max_angle>0.7853981634</max_angle></vertical>
          </scan><range><min>0.2</min><max>30</max><resolution>0.001</resolution></range></ray>
          <plugin name="odin_lidar" filename="libgazebo_ros_ray_sensor.so">
            <ros><namespace>/sim/odin1</namespace><remapping>~/out:=cloud_raw</remapping></ros>
            <output_type>sensor_msgs/PointCloud2</output_type><frame_name>odin_sim_lidar</frame_name>
          </plugin>
        </sensor>
        <!-- Pinhole approximation at official horizontal FOV; vertical FOV follows
             aspect ratio, NOT official 104 degrees. FishPoly not reproduced. -->
        <sensor name="rgb" type="camera">
          <pose>0.02271939 0.03473530 0.02639721 0.00366158 -0.00425942 -0.00306781</pose>
          <always_on>true</always_on><update_rate>10</update_rate>
          <camera><horizontal_fov>2.2514747351</horizontal_fov><image><width>1600</width><height>1296</height><format>R8G8B8</format></image><clip><near>0.02</near><far>70</far></clip></camera>
          <plugin name="odin_camera" filename="libgazebo_ros_camera.so">
            <ros><namespace>/sim/odin1</namespace><remapping>rgb/image_raw:=/sim/odin1/image</remapping><remapping>rgb/camera_info:=/sim/odin1/camera_info</remapping></ros>
            <camera_name>rgb</camera_name><frame_name>odin_sim_camera_optical</frame_name>
          </plugin>
        </sensor>
        <!-- 400 Hz is a simulation choice based on SDK smooth-send default,
             not verified hardware sample rate. Ideal/no noise. -->
        <sensor name="imu" type="imu">
          <pose>0.04218 -0.02897 0.00926 0 0 0</pose><always_on>true</always_on><update_rate>400</update_rate>
          <plugin name="odin_imu" filename="libgazebo_ros_imu_sensor.so">
            <ros><namespace>/sim/odin1</namespace><remapping>~/out:=imu</remapping></ros>
            <frame_name>odin_sim_imu</frame_name><initial_orientation_as_reference>false</initial_orientation_as_reference>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
