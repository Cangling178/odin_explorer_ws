<?xml version="1.0"?>
<sdf version="1.6">
  <world name="odin_sensor_bench">
    <gravity>0 0 -9.81</gravity>
    <physics type="ode"><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate></physics>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0 -1</direction></light>
    <model name="floor"><static>true</static><link name="floor">
      <collision name="floor"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
      <visual name="floor"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
    </link></model>
    <model name="target"><static>true</static><pose>2 0 0.5 0 0 0</pose><link name="target">
      <collision name="target"><geometry><box><size>0.1 1 1</size></box></geometry></collision>
      <visual name="target"><geometry><box><size>0.1 1 1</size></box></geometry><material><diffuse>0.8 0.15 0.08 1</diffuse></material></visual>
    </link></model>
    <!-- Stationary, elevated sensor bench, NOT the complete drive simulation.
         Same odin_link origin as URDF. Body geometry and 280 g are shared. -->
    <model name="odin_sensor_bench"><static>true</static><pose>0 0 0.5 0 0 0</pose>
      <link name="odin_link">
        <visual name="body"><geometry><mesh><uri>file://ODIN_MESH_PATH</uri></mesh></geometry></visual>
        <!-- Sensors are generated from config/odin_sensors.yaml and the URDF TF tree. -->
      </link>
    </model>
  </world>
</sdf>
