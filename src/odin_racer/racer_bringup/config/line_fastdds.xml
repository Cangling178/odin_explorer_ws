<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>line_shared_memory</transport_id>
      <type>SHM</type>
      <!-- Hold several full RGB frames, rather than the default 512 KiB. -->
      <segment_size>67108864</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>line_udp_discovery</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="line_simulation" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>line_shared_memory</transport_id>
        <transport_id>line_udp_discovery</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
